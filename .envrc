# .envrc
# Load local secrets (NOT committed to git)
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi

# Defaults (can be overridden in .envrc.local)
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-ap-southeast-1}"

export TF_ROOT="$(pwd)/terraform"

# Remind developer if .envrc.local is missing
if [ ! -f .envrc.local ]; then
  log_status ".envrc.local not found. Create it with your secrets (see SECURITY.md for guidance)."
fi
