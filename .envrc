# .envrc — direnv 入口（本文件入库，不含任何密钥）
#
# 用法：安装 direnv 后在本目录执行 `direnv allow`。
# 真实凭据写入同目录的 .envrc.local（已被 .gitignore 与 .dockerignore 排除）。

# 加载本地密钥（不提交到 git）
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi

# .envrc.local 建议导出的变量（语义与默认值见 README「安全配置」与 SECURITY.md）：
#   MUTONG_SESSION_SECRET        会话 Cookie HMAC 密钥（多副本必须共享同一值）
#   MUTONG_AUTH_SECRET           OAuth2 签名密钥（按 base64 解码，解码后需 ≥32 字节）
#   MUTONG_ADMIN_KEY             执行器危险操作的 X-Admin-Key
#   MUTONG_WEBHOOK_SECRET        告警 webhook HMAC-SHA256 密钥
#   MUTONG_EXTERNAL_ALERT_TOKEN  外部告警源准入 token
#   MUTONG_INIT_ADMIN_PASSWORD   首次启动创建 admin 的密码（账号已存在时不重置）
#   MUTONG_DB_USER / MUTONG_DB_PASSWORD
#   MUTONG_NEBULA_USER / MUTONG_NEBULA_PASS
#   MUTONG_REDIS_PASSWORD / MUTONG_REDIS_DB
#   MUTONG_TAVILY_KEY / MUTONG_GITHUB_TOKEN   外部知识检索（可选）
#   MUTONG_TRUSTED_PROXIES / MUTONG_ALLOWED_ORIGINS / MUTONG_ISSUER_URL
#
# 本仓库不使用 Terraform / AWS，历史上的 TF_ROOT 与 AWS_DEFAULT_REGION 已移除。

# 缺少本地密钥文件时提醒开发者
if [ ! -f .envrc.local ]; then
  log_status ".envrc.local not found. Create it with your secrets (see SECURITY.md and README 'Security Configuration' for guidance)."
fi