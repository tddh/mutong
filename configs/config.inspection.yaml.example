# Mutong 巡检配置
#
# 巡检规则加载优先级（同名规则先到先得）：
#   1. YAML 文件（configs/rules/inspection/*.yml）— 优先级最高
#   2. Go 代码内置规则（6 类）— YAML 同名规则优先
#   3. PostgreSQL 数据库规则 — 最低优先级
#
# ruleFiles 为空时自动扫描 configs/rules/inspection/ 目录
# 也可以显式指定 glob 模式：
#   ruleFiles:
#     - 'configs/rules/inspection/*.yml'

inspection:
  enabled: true
  cronSpec: "0 */6 * * *"
  # ruleFiles: []
