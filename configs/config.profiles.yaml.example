# Mutong 资源画像配置（同心圆模型数据源定义）
#
# 资源画像已拆分为独立文件，存放于 configs/profiles/ 目录：
#   pod.yml node.yml deployment.yml service.yml statefulset.yml daemonset.yml pvc.yml ingress.yml
#
# 如需添加新的资源类型，在 configs/profiles/ 下新建 <kind>.yml 文件即可。
# 如需显式指定加载顺序或排除某些文件，使用 resourceProfileFiles 字段：
#
# resourceProfileFiles:
#   - 'configs/profiles/pod.yml'
#   - 'configs/profiles/node.yml'

# resourceProfileFiles: []  # 留空则自动扫描 configs/profiles/*.yml
